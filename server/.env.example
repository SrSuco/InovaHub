# Porta da API
PORTA=3333

# Conexão com o MySQL
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=inovahub

# Segredo usado para assinar os tokens de login. Troque em produção.
JWT_SEGREDO=troque-este-segredo
# Validade do token: sessão normal e "manter conectado"
JWT_VALIDADE=8h
JWT_VALIDADE_LONGA=30d

# Origem do front-end liberada no CORS (vazio libera qualquer origem em desenvolvimento)
CORS_ORIGEM=http://localhost:5173
